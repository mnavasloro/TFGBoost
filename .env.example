# Keep all student work and model traffic inside the institution when possible.
TFGBOOST_DATA_DIR=./data
TFGBOOST_UPLOAD_DIR=./uploads
TFGBOOST_MAX_UPLOAD_MB=15
TFGBOOST_SESSION_DAYS=7
# Local model enrichment. Requires `ollama pull qwen3:8b`.
TFGBOOST_OLLAMA_ENABLED=true
TFGBOOST_OLLAMA_URL=http://localhost:11434
TFGBOOST_OLLAMA_MODEL=qwen3:8b
TFGBOOST_OLLAMA_TIMEOUT_SECONDS=600
TFGBOOST_OLLAMA_CONTEXT_TOKENS=4096
