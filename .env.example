# Mantén el trabajo del alumnado y el tráfico de modelos dentro de la institución siempre que sea posible.
TFGBOOST_DATA_DIR=./data
TFGBOOST_UPLOAD_DIR=./uploads
TFGBOOST_MAX_UPLOAD_MB=15
TFGBOOST_SESSION_DAYS=7

# Modelo preseleccionado: "none" (solo reglas), "ollama:<modelo>" o "anthropic:<modelo>".
TFGBOOST_DEFAULT_MODEL=ollama:qwen3:8b

# --- Ollama (local) ---
TFGBOOST_OLLAMA_ENABLED=true
# En Docker usa http://host.docker.internal:11434
TFGBOOST_OLLAMA_URL=http://localhost:11434
# Modelos ofrecidos, con contexto opcional por modelo (@tokens). Vacío = todos los instalados.
TFGBOOST_OLLAMA_MODELS=qwen3:8b@4096,qwen3:14b@8192
TFGBOOST_OLLAMA_CONTEXT_TOKENS=4096
TFGBOOST_OLLAMA_MAX_OUTPUT_TOKENS=1200
TFGBOOST_OLLAMA_TIMEOUT_SECONDS=600
TFGBOOST_OLLAMA_CONCURRENCY=1

# --- Claude (Anthropic, pago por tokens) ---
# El texto del borrador sale de la universidad: el estudiante debe aceptarlo en cada análisis.
TFGBOOST_ANTHROPIC_ENABLED=false
# ANTHROPIC_API_KEY=sk-ant-...
TFGBOOST_ANTHROPIC_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5
TFGBOOST_ANTHROPIC_EFFORT=medium
TFGBOOST_ANTHROPIC_MAX_OUTPUT_TOKENS=16000
TFGBOOST_ANTHROPIC_FALLBACKS=true
TFGBOOST_ANTHROPIC_CONCURRENCY=4
# --- OpenRouter (modelos abiertos y comerciales con una sola clave, pago por tokens) ---
TFGBOOST_OPENROUTER_ENABLED=false
# OPENROUTER_API_KEY=sk-or-...
# Identificadores de https://openrouter.ai/models; "@<tokens>" fija el contexto (si no, se lee del catálogo).
TFGBOOST_OPENROUTER_MODELS=qwen/qwen3.5-35b-a3b,qwen/qwen3.5-122b-a10b,openai/gpt-oss-120b,google/gemma-3-27b-it
# Incluye el razonamiento interno de modelos como Qwen 3.5 o gpt-oss.
TFGBOOST_OPENROUTER_MAX_OUTPUT_TOKENS=16000
# Razonamiento: auto (desactivado; effort=low si el modelo lo exige), off, low, medium o high.
# Con Qwen 3.5, low/medium/high hacen que razone hasta agotar los tokens: usa auto u off.
TFGBOOST_OPENROUTER_REASONING=auto
TFGBOOST_OPENROUTER_TIMEOUT_SECONDS=300
TFGBOOST_OPENROUTER_CONCURRENCY=4
# true: solo proveedores que admiten el esquema JSON (más fiable).
TFGBOOST_OPENROUTER_REQUIRE_PARAMETERS=true
# Proveedor: cheap (el más barato; con peticiones en paralelo, igual de rápido que fast en las pruebas),
# fast (el más rápido sin superar el precio publicado del modelo) o default (reparto de OpenRouter).
TFGBOOST_OPENROUTER_ROUTING=cheap

# Peticiones simultáneas por análisis con modelos remotos (mismo coste, menos espera).
TFGBOOST_LLM_PARALLEL_REQUESTS=4

# Análisis diarios por estudiante con modelos remotos (Claude y OpenRouter; 0 = sin límite).
TFGBOOST_REMOTE_DAILY_LIMIT=5

# Madurez mínima para poder enviar un borrador al tutor (triaje).
TFGBOOST_SUBMIT_THRESHOLD=50
